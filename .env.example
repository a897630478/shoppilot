# ShopPilot 环境变量模板
# 用法：cp .env.example .env.local  然后填入真实值

# ── PostgreSQL ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=eduagent
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ── MinIO（商品图片桶）──
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=product-images

# ── 大模型（DeepSeek）──
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL_CHAT=
DEEPSEEK_MODEL_CODER=

# ── 本地模型权重路径 ──
RERANKER_MODEL_PATH=./backend/models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./backend/models/classifier/all-MiniLM-L6-v2
FINETUNED_CLASSIFIER_PATH=./backend/models/classifier/finetune

# ── JWT ──
JWT_SECRET_KEY=please-change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 应用 ──
APP_ENV=local
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default

# ── 可选：Web 搜索（留空则用 DuckDuckGo）──
TAVILY_API_KEY=
